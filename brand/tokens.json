{
  "version": "1.0.0",
  "name": "Jinstone Visual System",
  "thesis": "Measure the path. Build the silicon.",
  "colors": {
    "carbon": "#14181C",
    "graphite": "#272E34",
    "paper": "#F3F4F0",
    "white": "#FFFFFF",
    "route": "#20B8A6",
    "compute": "#4F6FF2",
    "proof": "#E4614D",
    "fixture": "#D8A93D",
    "muted_dark": "#98A2A8",
    "muted_light": "#5B656C",
    "line_dark": "#394149",
    "line_light": "#D6D9D4"
  },
  "typography": {
    "display": "IBM Plex Sans, Bahnschrift, Segoe UI, sans-serif",
    "body": "IBM Plex Sans, Segoe UI, sans-serif",
    "mono": "IBM Plex Mono, Consolas, monospace",
    "cjk": "Noto Sans SC, Microsoft YaHei, sans-serif"
  },
  "spacing_px": [4, 8, 16, 24, 32, 48, 64, 96, 128],
  "stroke_px": {
    "hairline": 1,
    "route": 3,
    "selected_route": 6
  },
  "corner_radius_px": {
    "default": 0,
    "compact_control": 4
  },
  "evidence_levels": {
    "fixture": {
      "label": "FIXTURE",
      "color": "#D8A93D",
      "claim": "Software contract only"
    },
    "host": {
      "label": "HOST",
      "color": "#4F6FF2",
      "claim": "Host baseline"
    },
    "board": {
      "label": "BOARD",
      "color": "#20B8A6",
      "claim": "Measured target run"
    },
    "fpga": {
      "label": "FPGA",
      "color": "#20B8A6",
      "claim": "Architecture proof"
    },
    "silicon": {
      "label": "SILICON",
      "color": "#E4614D",
      "claim": "Physical implementation"
    }
  },
  "motion": {
    "fps": 24,
    "prototype_fps": 12,
    "release_intro_seconds": 6,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "route_draw_seconds": 1.2,
    "metric_hold_seconds": 1.5
  }
}
